# NeonDB (Postgres) — copy from the Neon dashboard
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Admin panel login (seeded into the DB by `prisma db seed`)
ADMIN_EMAIL=admin@techforge.dev
ADMIN_PASSWORD=change-me

# Session cookie signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Vercel Blob — product image uploads
BLOB_READ_WRITE_TOKEN=

# Stripe test mode keys (sk_test_...) and webhook signing secret (whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
